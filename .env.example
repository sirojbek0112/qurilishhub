# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Authentication Secrets (override in production)
JWT_SECRET="qurilishhub_dev_access_secret_change_me"
JWT_REFRESH_SECRET="qurilishhub_dev_refresh_secret_change_me"

# SQLite Database Path (local persistent storage)
SQLITE_DB_PATH="./data/qurilishhub.db"

# Payment Providers (Sandbox mode by default until credentials are configured)
PAYMENT_MODE="sandbox"
CLICK_MERCHANT_ID="sandbox_click_merchant"
CLICK_SECRET_KEY="sandbox_click_secret"
PAYME_MERCHANT_ID="sandbox_payme_merchant"
PAYME_SECRET_KEY="sandbox_payme_secret"
UZUM_SERVICE_ID="sandbox_uzum_service"
UZUM_SECRET_KEY="sandbox_uzum_secret"
